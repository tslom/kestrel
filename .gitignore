# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# App-owned sqlite data (runtime state, not source)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/backups/
# PDFs dropped on the console, kept so answers can cite their pages (app/docs.py)
backend/data/docs/
# Desktop window geometry — per-machine, written on close by launch_app.py
backend/data/window.json
# Everything else under data/ is personal too (and in a worktree it's a
# symlink to the real thing): nothing in it is source.
backend/data
backend/data/

# Personal exports and dumps that tend to get dropped into a checkout
*.sqlite
*.sqlite3
*.vcf
*.ics
*.mbox
*.zip
my_spotify_data*

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# JetBrains
.idea/

# Machine-specific desktop bundle (regenerate with scripts/make-app.sh)
/Kestrel.app/
/Vault Dashboard.app/
scripts/dashboard-preview.png

# --- Location relay (Cloudflare Worker) ---
relay/.dev.vars
relay/.wrangler/
